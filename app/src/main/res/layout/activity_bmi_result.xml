<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F1115"
    android:orientation="vertical"
    android:padding="16dp"
    tools:context=".BmiResultActivity">

    <!-- Top Bar dengan Tombol Back & Judul -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Back"
            android:src="@drawable/ic_back"
            app:tint="#F2F4F8" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginStart="12dp"
            android:layout_toEndOf="@id/btnBack"
            android:text="Hasil Analisis BMI"
            android:textColor="#F2F4F8"
            android:textSize="20sp"
            android:textStyle="bold" />
    </RelativeLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="12dp">

        <!-- Kartu Hasil BMI -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_display"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="28dp">

            <!-- Status Kategori -->
            <TextView
                android:id="@+id/tvKategori"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.1"
                android:text="BERAT BADAN IDEAL"
                android:textColor="#4FD1C5"
                android:textSize="18sp"
                android:textStyle="bold" />

            <!-- Skor Angka BMI -->
            <TextView
                android:id="@+id/tvHasilAngka"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="16dp"
                android:text="20.8"
                android:textColor="#F2F4F8"
                android:textSize="64sp"
                android:textStyle="bold" />

            <!-- Deskripsi Saran Kesehatan -->
            <TextView
                android:id="@+id/tvSaran"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingExtra="4dp"
                android:text="Kerja bagus! Pertahankan pola makan seimbang dan rutinitas olahraga harianmu."
                android:textAlignment="center"
                android:textColor="#8A93A6"
                android:textSize="15sp" />

        </LinearLayout>

        <!-- Tombol Hitung Ulang -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnHitungUlang"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="24dp"
            android:background="@drawable/bg_button_equals"
            android:text="HITUNG ULANG"
            android:textAllCaps="false"
            android:textColor="#0F1115"
            android:textSize="20sp"
            android:textStyle="bold" />

    </LinearLayout>
</LinearLayout>
