<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F6F9">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="12dp"
            app:cardElevation="6dp"
            app:cardBackgroundColor="#FFFFFF">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🧾 HASIL EXPLICIT INTENT - NOTA TRANSAKSI"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="#00897B"
                    android:layout_gravity="center_horizontal" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Data Dikirimkan via Intent.putExtra() dari NewTaskActivity"
                    android:textSize="12sp"
                    android:textColor="#7F8C8D"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="4dp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#E0E0E0"
                    android:layout_marginVertical="16dp" />

                <TextView
                    android:id="@+id/tvNewReceiptDetail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Memuat data transaksi dari Intent..."
                    android:textSize="15sp"
                    android:textColor="#333333"
                    android:lineSpacingExtra="4dp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#E0E0E0"
                    android:layout_marginVertical="16dp" />

                <Button
                    android:id="@+id/btnNewBackToCalc"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="⬅️ Kembali ke NewTaskActivity"
                    android:backgroundTint="#00897B"
                    android:textStyle="bold" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>

    </LinearLayout>
</ScrollView>
