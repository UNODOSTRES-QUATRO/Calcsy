<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F1115"
    android:orientation="vertical"
    android:padding="16dp"
    tools:context=".MainActivity">

    <!-- Top Bar dengan Tombol BMI & History di Kanan Atas -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:text="Calcsy"
            android:textColor="#F2F4F8"
            android:textSize="20sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:orientation="horizontal">

            <!-- Tombol BMI Calculator -->
            <ImageButton
                android:id="@+id/btnBmi"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginEnd="8dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="BMI Calculator"
                android:src="@drawable/ic_bmi" />

            <!-- Tombol History di Kanan Atas -->
            <ImageButton
                android:id="@+id/btnHistory"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="History"
                android:src="@drawable/ic_history" />
        </LinearLayout>
    </RelativeLayout>

    <!-- Area Display (~38% tinggi layar) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="0.38"
        android:background="@drawable/bg_display"
        android:gravity="bottom|end"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Riwayat Sementara (Maksimal 4 persamaan sebelumnya di bagian atas display) -->
        <TextView
            android:id="@+id/tvRecentHistory"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:maxLines="4"
            android:textColor="#5A6375"
            android:textSize="15sp"
            tools:text="10 + 5 = 15\n15 x 2 = 30" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="6dp"
            android:background="#232832" />

        <!-- Ekspresi Matematika Aktif -->
        <TextView
            android:id="@+id/tvExpression"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:gravity="end"
            android:maxLines="2"
            android:textColor="#8A93A6"
            android:textSize="22sp"
            tools:text="125 + 50" />

        <!-- Hasil Perhitungan Aktif -->
        <TextView
            android:id="@+id/tvResult"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="end"
            android:maxLines="1"
            android:textColor="#F2F4F8"
            android:textSize="52sp"
            android:textStyle="bold"
            app:autoSizeMaxTextSize="52sp"
            app:autoSizeMinTextSize="24sp"
            app:autoSizeTextType="uniform"
            tools:text="175" />
    </LinearLayout>

    <!-- Space antara Display dan Keypad -->
    <View
        android:layout_width="match_parent"
        android:layout_height="12dp" />

    <!-- Area Keypad (~62% tinggi layar) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="0.62"
        android:orientation="vertical">

        <!-- Baris 1: AC, DEL, ÷ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnClear"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_margin="5dp"
                android:layout_weight="2"
                android:background="@drawable/bg_button_action"
                android:text="AC"
                android:textAllCaps="false"
                android:textColor="#FF7A7A"
                android:textSize="24sp"
                android:textStyle="bold" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnDelete"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_margin="5dp"
                android:layout_weight="1"
                android:background="@drawable/bg_button_action"
                android:text="DEL"
                android:textAllCaps="false"
                android:textColor="#FF7A7A"
                android:textSize="24sp"
                android:textStyle="bold" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnDivide"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_margin="5dp"
                android:layout_weight="1"
                android:background="@drawable/bg_button_operator"
                android:text="÷"
                android:textAllCaps="false"
                android:textColor="#4FD1C5"
                android:textSize="30sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Baris 2: 7, 8, 9, × -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn7"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_margin="5dp"
                android:layout_weight="1"
                android:background="@drawable/bg_button_number"
                android:text="7"
                android:textAllCaps="false"
                android:textColor="#F2F4F8"
                android:textSize="28sp"
                android:textStyle="bold" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn8"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_margin="5dp"
                android:layout_weight="1"
                android:background="@drawable/bg_button_number"
                android:text="8"
                android:textAllCaps="false"
                android:textColor="#F2F4F8"
                android:textSize="28sp"
                android:textStyle="bold" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn9"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_margin="5dp"
                android:layout_weight="1"
                android:background="@drawable/bg_button_number"
                android:text="9"
                android:textAllCaps="false"
                android:textColor="#F2F4F8"
                android:textSize="28sp"
                android:textStyle="bold" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnMultiply"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_margin="5dp"
                android:layout_weight="1"
                android:background="@drawable/bg_button_operator"
                android:text="×"
                android:textAllCaps="false"
                android:textColor="#4FD1C5"
                android:textSize="30sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Baris 3: 4, 5, 6, − -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn4"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_margin="5dp"
                android:layout_weight="1"
                android:background="@drawable/bg_button_number"
                android:text="4"
                android:textAllCaps="false"
                android:textColor="#F2F4F8"
                android:textSize="28sp"
                android:textStyle="bold" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn5"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_margin="5dp"
                android:layout_weight="1"
                android:background="@drawable/bg_button_number"
                android:text="5"
                android:textAllCaps="false"
                android:textColor="#F2F4F8"
                android:textSize="28sp"
                android:textStyle="bold" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn6"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_margin="5dp"
                android:layout_weight="1"
                android:background="@drawable/bg_button_number"
                android:text="6"
                android:textAllCaps="false"
                android:textColor="#F2F4F8"
                android:textSize="28sp"
                android:textStyle="bold" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnMinus"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_margin="5dp"
                android:layout_weight="1"
                android:background="@drawable/bg_button_operator"
                android:text="−"
                android:textAllCaps="false"
                android:textColor="#4FD1C5"
                android:textSize="30sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Baris 4: 1, 2, 3, + -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn1"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_margin="5dp"
                android:layout_weight="1"
                android:background="@drawable/bg_button_number"
                android:text="1"
                android:textAllCaps="false"
                android:textColor="#F2F4F8"
                android:textSize="28sp"
                android:textStyle="bold" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn2"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_margin="5dp"
                android:layout_weight="1"
                android:background="@drawable/bg_button_number"
                android:text="2"
                android:textAllCaps="false"
                android:textColor="#F2F4F8"
                android:textSize="28sp"
                android:textStyle="bold" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn3"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_margin="5dp"
                android:layout_weight="1"
                android:background="@drawable/bg_button_number"
                android:text="3"
                android:textAllCaps="false"
                android:textColor="#F2F4F8"
                android:textSize="28sp"
                android:textStyle="bold" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnPlus"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_margin="5dp"
                android:layout_weight="1"
                android:background="@drawable/bg_button_operator"
                android:text="+"
                android:textAllCaps="false"
                android:textColor="#4FD1C5"
                android:textSize="30sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Baris 5: 0, ,, = -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn0"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_margin="5dp"
                android:layout_weight="2"
                android:background="@drawable/bg_button_number"
                android:text="0"
                android:textAllCaps="false"
                android:textColor="#F2F4F8"
                android:textSize="28sp"
                android:textStyle="bold" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnComma"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_margin="5dp"
                android:layout_weight="1"
                android:background="@drawable/bg_button_number"
                android:text=","
                android:textAllCaps="false"
                android:textColor="#F2F4F8"
                android:textSize="28sp"
                android:textStyle="bold" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnEquals"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_margin="5dp"
                android:layout_weight="1"
                android:background="@drawable/bg_button_equals"
                android:text="="
                android:textAllCaps="false"
                android:textColor="#0F1115"
                android:textSize="30sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>