<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_main"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Header & Navigasi -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingBottom="12dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Calcsy"
            android:textColor="@color/text_primary"
            android:textSize="22sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnOpenBmi"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_button_action"
            android:paddingHorizontal="14dp"
            android:text="BMI"
            android:textColor="@color/text_primary"
            android:textSize="13sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnOpenHistory"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:background="@drawable/bg_button_action"
            android:paddingHorizontal="14dp"
            android:text="Riwayat"
            android:textColor="@color/text_primary"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Layar Hasil Kalkulator -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginBottom="16dp"
        android:layout_weight="1.2"
        android:background="@drawable/bg_display"
        android:gravity="bottom|end"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:id="@+id/tvExpression"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="start"
            android:gravity="end"
            android:singleLine="true"
            android:text=""
            android:textColor="@color/text_secondary"
            android:textSize="22sp" />

        <TextView
            android:id="@+id/tvResult"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:ellipsize="end"
            android:gravity="end"
            android:maxLines="1"
            android:text="0"
            android:textColor="@color/text_primary"
            android:textSize="44sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Keypad 5 Baris -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="2.5"
        android:orientation="vertical">

        <!-- Baris 1 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnClear"
                style="@style/CalcButton"
                android:background="@drawable/bg_button_action"
                android:text="C"
                android:textColor="#FF6B6B" />

            <Button
                android:id="@+id/btnBackspace"
                style="@style/CalcButton"
                android:background="@drawable/bg_button_action"
                android:text="⌫" />

            <Button
                android:id="@+id/btnPercent"
                style="@style/CalcButton"
                android:background="@drawable/bg_button_action"
                android:text="%" />

            <Button
                android:id="@+id/btnDivide"
                style="@style/CalcButton"
                android:background="@drawable/bg_button_operator"
                android:text="÷" />
        </LinearLayout>

        <!-- Baris 2 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn7"
                style="@style/CalcButton"
                android:background="@drawable/bg_button_number"
                android:text="7" />

            <Button
                android:id="@+id/btn8"
                style="@style/CalcButton"
                android:background="@drawable/bg_button_number"
                android:text="8" />

            <Button
                android:id="@+id/btn9"
                style="@style/CalcButton"
                android:background="@drawable/bg_button_number"
                android:text="9" />

            <Button
                android:id="@+id/btnMultiply"
                style="@style/CalcButton"
                android:background="@drawable/bg_button_operator"
                android:text="×" />
        </LinearLayout>

        <!-- Baris 3 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn4"
                style="@style/CalcButton"
                android:background="@drawable/bg_button_number"
                android:text="4" />

            <Button
                android:id="@+id/btn5"
                style="@style/CalcButton"
                android:background="@drawable/bg_button_number"
                android:text="5" />

            <Button
                android:id="@+id/btn6"
                style="@style/CalcButton"
                android:background="@drawable/bg_button_number"
                android:text="6" />

            <Button
                android:id="@+id/btnMinus"
                style="@style/CalcButton"
                android:background="@drawable/bg_button_operator"
                android:text="-" />
        </LinearLayout>

        <!-- Baris 4 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn1"
                style="@style/CalcButton"
                android:background="@drawable/bg_button_number"
                android:text="1" />

            <Button
                android:id="@+id/btn2"
                style="@style/CalcButton"
                android:background="@drawable/bg_button_number"
                android:text="2" />

            <Button
                android:id="@+id/btn3"
                style="@style/CalcButton"
                android:background="@drawable/bg_button_number"
                android:text="3" />

            <Button
                android:id="@+id/btnPlus"
                style="@style/CalcButton"
                android:background="@drawable/bg_button_operator"
                android:text="+" />
        </LinearLayout>

        <!-- Baris 5 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnDoubleZero"
                style="@style/CalcButton"
                android:background="@drawable/bg_button_number"
                android:text="00" />

            <Button
                android:id="@+id/btn0"
                style="@style/CalcButton"
                android:background="@drawable/bg_button_number"
                android:text="0" />

            <Button
                android:id="@+id/btnDot"
                style="@style/CalcButton"
                android:background="@drawable/bg_button_number"
                android:text="." />

            <Button
                android:id="@+id/btnEquals"
                style="@style/CalcButton"
                android:background="@drawable/bg_button_operator"
                android:text="=" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>